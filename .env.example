# Copy to .env.local and fill in real values.
# Note: MONGODB_URI, AUTH_USERNAME, AUTH_PASSWORD, and IRON_SESSION_SECRET are
# currently only defined in this project's Production scope on Vercel — pull
# them with `vercel env pull .env.local --environment=production` if you need
# a working local dev environment, or add dev/preview-scoped values via
# `vercel env add` for a proper separation between local dev and prod data.

# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URI=

# Database name within the MongoDB cluster above.
MONGODB_DB=avis

# Shared credentials gating the whole app (see app/login/actions.ts).
AUTH_USERNAME=
AUTH_PASSWORD=

# Secret used to encrypt the iron-session cookie. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
IRON_SESSION_SECRET=

# Base64-encoded Google service account JSON — grants access to the Sheets
# API used by lib/googleSheets*.ts (BDD, Parking, Atelier, RL, Import).
# Generate with: base64 -w0 service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# The spreadsheet ID all lib/googleSheets*.ts files read/write — the long id
# in the sheet's URL between /d/ and /edit.
GOOGLE_SHEETS_ID=

# Only needed to run the optional diagnostic at scripts/test-service-account.ts
# (verifies the service account can reach Sheets/Drive) — not read by the app
# itself.
GOOGLE_DRIVE_FOLDER_ID=

# Populated automatically by `vercel env pull` / `vercel dev` — not something
# you set by hand.
VERCEL_OIDC_TOKEN=
