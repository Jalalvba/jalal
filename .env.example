# Copy to .env.local and fill in real values.
# Note: MONGODB_URI, IRON_SESSION_SECRET, and the GOOGLE_OAUTH_* pair below
# are currently only defined in this project's Production scope on Vercel —
# pull them with `vercel env pull .env.local --environment=production` if
# you need a working local dev environment, or add dev/preview-scoped values
# via `vercel env add` for a proper separation between local dev and prod data.

# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URI=

# Database name within the MongoDB cluster above.
MONGODB_DB=avis

# Google OAuth 2.0 Web application client (Google Cloud Console → APIs &
# Services → Credentials). This app authorizes exactly one Google account
# (see lib/googleOAuth.ts's AUTHORIZED_EMAIL) — there is no user database,
# no registration flow. Authorized redirect URI must be registered in the
# console as {origin}/api/auth/google/callback for every environment this
# runs in (e.g. http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Secret used to encrypt the iron-session cookie. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
IRON_SESSION_SECRET=

# Base64-encoded Google service account JSON — grants access to the Sheets
# API used by lib/googleSheets*.ts (BDD, Parking, Atelier, RL, Import).
# Generate with: base64 -w0 service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# The spreadsheet ID all lib/googleSheets*.ts files read/write — the long id
# in the sheet's URL between /d/ and /edit.
GOOGLE_SHEETS_ID=

# A SEPARATE spreadsheet ("Calendrier des rendez-vous quotidiens") holding
# the monthly appointment calendar tabs (e.g. "Juillet 2026") generated by
# an external Google Apps Script — NOT the same file as GOOGLE_SHEETS_ID.
# The service account above must be shared as Editor on this spreadsheet
# too (a separate Share step from GOOGLE_SHEETS_ID's sharing).
GOOGLE_RDV_SHEETS_ID=

# Only needed to run the optional diagnostic at scripts/test-service-account.ts
# (verifies the service account can reach Sheets/Drive) — not read by the app
# itself.
GOOGLE_DRIVE_FOLDER_ID=

# Populated automatically by `vercel env pull` / `vercel dev` — not something
# you set by hand.
VERCEL_OIDC_TOKEN=

# Gemini API key (Google AI Studio, "jalal" project) — powers
# /api/bdd/reformulate-comment's free-tier Flash/Flash-Lite comment
# reformulation. Pro models require paid billing and are not used here.
GEMINI_API_KEY=your_gemini_api_key_here

# USD -> MAD conversion rate used to display Gemini call costs in dirhams
# (lib/gemini-cost-tracker.ts). Optional — defaults to 9.4 if unset.
USD_TO_MAD_RATE=9.4

# Starting prepaid credit balance in USD loaded on the Gemini API key, used as
# the baseline for costInfo.remainingCreditUsd / getRemainingCredit(). Paid-tier
# spend recorded in Mongo is subtracted from this, so update it whenever you top
# up the balance. Optional — defaults to 0 (which just makes remaining credit
# read as negative spend-to-date).
GEMINI_PREPAID_USD_BALANCE=0

# Trigger token for the separate fleet-data-import pipeline
# (~/import, deployed at https://import-red.vercel.app), used by
# app/api/trigger-import to call that project's GET /api?token=... — must be
# server-side only, never exposed to the browser. Value must exactly match
# that project's own PIPELINE_TRIGGER_SECRET (~/import/.env). Add via
# `vercel env add IMPORT_PIPELINE_TOKEN` on THIS project (jalal), not on
# ~/import.
IMPORT_PIPELINE_TOKEN=
